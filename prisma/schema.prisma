generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model assignment_class {
  assignment_id Int
  class_id      Int
  assignments   assignments @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classes       classes     @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([assignment_id, class_id])
}

model assignment_student {
  id                      Int                       @id @default(autoincrement())
  assignment_id           Int?
  student_id              Int?
  status                  assignmentstatus?
  created_at              DateTime?                 @db.Timestamp(6)
  assignments             assignments?              @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students                students?                 @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  test_student_assignment test_student_assignment[]
}

model assignments {
  id                  Int                   @id @default(autoincrement())
  start_date          DateTime              @db.Timestamp(6)
  deadline_date       DateTime              @db.Timestamp(6)
  assignee_id         Int?
  assignee_type       assigneetype
  description         String?               @db.VarChar
  status              assignmentstatus
  header              String?               @db.VarChar
  subject_id          Int?
  assignment_class    assignment_class[]
  assignment_document assignment_document[]
  assignment_student  assignment_student[]
  assignment_test     assignment_test[]
  subjects            subjects?             @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments            comments[]
  student_submissions student_submissions[]

  @@index([id], map: "ix_assignments_id")
}

model classes {
  id                   Int                    @id @default(autoincrement())
  class_code           String                 @unique @db.VarChar
  grade                Int
  institution_id       Int
  announcement_classes announcement_classes[] 
  assignment_class     assignment_class[]
  institutions         institutions           @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedules            schedules[]
  student_class        student_class[]
  teacher_class        teacher_class[]

  @@index([id], map: "ix_classes_id")
}

model comments {
  id            Int         @id @default(autoincrement())
  assignment_id Int
  user_id       Int
  user_type     usertype
  content       String      @db.VarChar
  created_at    DateTime?   @db.Timestamp(6)
  assignments   assignments @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_comments_id")
}

model contents {
  id                 Int                  @id @default(autoincrement())
  unit_id            Int
  content_name       String?              @db.VarChar
  level              Int?
  content_id         String?              @unique @db.Uuid
  unit_no            Int
  order              Int?
  publish_id         Int
  page_start         Int?
  page_end           Int?
  content_count      Int?
  content_type       contenttype
  content_url        String?              @db.VarChar
  parent_id          Int?
  content_embeddings content_embeddings[]
  publishes          publishes            @relation(fields: [publish_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units              units                @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_content    student_content[]

  @@index([id], map: "ix_contents_id")
}

model institutions {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar
  phone_number        String                @db.VarChar
  address             String?               @db.VarChar
  email               String?               @unique(map: "ix_institutions_email") @db.VarChar
  validation_code     String?               @db.VarChar
  image               String?               @db.VarChar
  admins              admins[]
  classes             classes[]
  lessons             lessons[]
  student_institution student_institution[]
  teacher_institution teacher_institution[]

  @@index([address], map: "ix_institutions_address")
  @@index([id], map: "ix_institutions_id")
  @@index([name], map: "ix_institutions_name")
  @@index([phone_number], map: "ix_institutions_phone_number")
}

model lesson_schedules {
  id          Int       @id @default(autoincrement())
  lesson_id   Int
  schedule_id Int
  start_time  DateTime  @db.Time(6)
  end_time    DateTime  @db.Time(6)
  day_of_week dayofweek
  teacher_id  Int
  lessons     lessons   @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedules   schedules @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers    teachers  @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_lesson_schedules_id")
}

model lessons {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar
  grade            Int
  curriculum_year  DateTime           @db.Date
  institution_id   Int
  subject_id       Int?
  description      String?            @db.VarChar
  lesson_image     String?            @db.VarChar
  lesson_schedules lesson_schedules[]
  institutions     institutions       @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects         subjects?          @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publish_lesson   publish_lesson[]
  teacher_lesson   teacher_lesson[]

  @@index([id], map: "ix_lessons_id")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model parent_student {
  parent_id  Int
  student_id Int
  parents    parents  @relation(fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students   students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([parent_id, student_id])

}

model parents {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar
  surname              String                 @db.VarChar
  email                String                 @db.VarChar
  phone                String                 @db.VarChar
  announcement_parents announcement_parents[]
  parent_student       parent_student[]       

  @@index([id], map: "ix_parents_id")
}

model questions {
  id                   Int                    @id @default(autoincrement())
  question_number      Int?
  test_id              Int?
  question_type        questiontype
  question_text        String?                @db.VarChar
  options              Json?
  correct_answers      Json?
  question_url         String?                @db.VarChar
  explanation          String?                @db.VarChar
  tests                tests?                 @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_test_answers student_test_answers[]

  @@index([id], map: "ix_questions_id")
  @@index([question_number], map: "ix_questions_question_number")
}

model schedules {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar
  created_at       DateTime?          @db.Timestamptz(6)
  updated_at       DateTime?          @db.Timestamptz(6)
  class_id         Int
  status           schedulestatus
  lesson_schedules lesson_schedules[]
  classes          classes            @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_schedules_id")
}

model student_class {
  student_id Int
  class_id   Int
  classes    classes  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students   students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([student_id, class_id])
}

model student_institution {
  student_id     Int
  institution_id Int
  institutions   institutions @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students       students     @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([student_id, institution_id])
}

model students {
  id                         Int                         @id @default(autoincrement())
  name                       String                      @db.VarChar
  surname                    String                      @db.VarChar
  gender                     String?                     @db.VarChar
  email                      String                      @unique @db.VarChar
  password                   String                      @db.VarChar
  birth_date                 DateTime?                   @db.Date
  school_name                String?                     @db.VarChar
  grade                      Int?
  is_active                  Boolean?
  photo                      String?                     @db.VarChar
  school_no                  String?                     @db.VarChar
  validation_code            String?                     @db.VarChar
  validation_code_expiration DateTime?                   @db.Timestamp(6)
  assignment_student         assignment_student[]
  parent_student             parent_student[]            
  student_analytics_summary  student_analytics_summary[]
  student_badges             student_badges[]
  student_class              student_class[]
  student_content            student_content[]
  student_game_progresses    student_game_progresses[]
  student_institution        student_institution[]
  student_schedules          student_schedules[]
  student_submissions        student_submissions[]
  student_tests              student_tests[]

  @@index([id], map: "ix_students_id")
}

model subjects {
  id              Int               @id @default(autoincrement())
  subject_name    subject_name
  image           String?           @db.VarChar
  assignments     assignments[]
  games           games[]
  lessons         lessons[]
  publishes       publishes[]
  teacher_subject teacher_subject[]
  units           units[]

  @@index([id], map: "ix_subjects_id")
}

model teacher_class {
  teacher_id Int
  class_id   Int
  classes    classes  @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers   teachers @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([teacher_id, class_id])
}

model teacher_institution {
  teacher_id     Int
  institution_id Int
  institutions   institutions @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers       teachers     @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([teacher_id, institution_id])
}

model teacher_lesson {
  teacher_id Int
  lesson_id  Int
  lessons    lessons  @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers   teachers @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([teacher_id, lesson_id])
}

model teachers {
  id                         Int                     @id @default(autoincrement())
  name                       String?                 @db.VarChar
  surname                    String?                 @db.VarChar
  email                      String                  @unique(map: "ix_teachers_email") @db.VarChar
  password                   String                  @db.VarChar
  gender                     String?                 @db.VarChar
  title                      String?                 @db.VarChar
  is_active                  Boolean?
  phone_number               String?                 @db.VarChar
  photo                      String?                 @db.VarChar
  validation_code            String?                 @db.VarChar
  validation_code_expiration DateTime?               @db.Timestamp(6)
  announcement_teachers      announcement_teachers[]
  lesson_schedules           lesson_schedules[]
  teacher_class              teacher_class[]
  teacher_institution        teacher_institution[]
  teacher_lesson             teacher_lesson[]
  teacher_subject            teacher_subject[]

  @@index([gender], map: "ix_teachers_gender")
  @@index([id], map: "ix_teachers_id")
  @@index([name], map: "ix_teachers_name")
  @@index([surname], map: "ix_teachers_surname")
  @@index([title], map: "ix_teachers_title")
  @@index([phone_number], map: "ix_teachers_phone_number")
}

model test_student_assignment {
  test_id               Int
  assignment_student_id Int
  status                assignmentstatus
  answers               String[]           @db.VarChar
  score                 Int?
  evaluation            String?            @db.VarChar
  assignment_student    assignment_student @relation(fields: [assignment_student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tests                 tests              @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([test_id, assignment_student_id])
}

model tests {
  id                      Int                       @id @default(autoincrement())
  name                    String?                   @db.VarChar(255)
  test_no                 Int?
  unit_id                 Int?
  publish_id              Int
  test_type               String?                   @db.VarChar
  test_url                String?                   @db.VarChar
  assignment_test         assignment_test[]
  questions               questions[]
  student_tests           student_tests[]
  test_student_assignment test_student_assignment[]
  publishes               publishes                 @relation(fields: [publish_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units                   units?                    @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_tests_id")
  @@index([name], map: "ix_tests_name")
  @@index([test_no], map: "ix_tests_test_no")
  @@index([test_type], map: "ix_tests_test_type")
  @@index([test_url], map: "ix_tests_test_url")
}

model units {
  id                Int              @id @default(autoincrement())
  name              String           @db.VarChar
  grade             Int
  unit_no           Int?
  subject_id        Int
  source            String?          @db.VarChar
  learning_outcomes Json?
  contents          contents[]
  homework_ideas    homework_ideas[]
  tests             tests[]
  subjects          subjects         @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_units_id")
}

model teacher_subject {
  teacher_id Int
  subject_id Int
  subjects   subjects @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers   teachers @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([teacher_id, subject_id])
}

model admins {
  id             Int           @id @default(autoincrement())
  name           String?       @db.VarChar
  email          String?       @unique(map: "ix_admins_email") @db.VarChar
  password       String        @db.VarChar
  institution_id Int?
  institutions   institutions? @relation(fields: [institution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_admins_id")
  @@index([name], map: "ix_admins_name")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model announcement_classes {
  announcement_id Int
  class_id        Int
  announcements   announcements? @relation(fields: [announcement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classes         classes?       @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([announcement_id, class_id])


}

model announcement_parents {
  announcement_id Int
  parent_id       Int
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parents         parents       @relation(fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([announcement_id, parent_id])
}

model announcement_teachers {
  announcement_id Int
  teacher_id      Int
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teachers        teachers      @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([announcement_id, teacher_id])
}

model announcements {
  id                    Int                     @id @default(autoincrement())
  title                 String                  @db.VarChar
  content               String
  created_at            DateTime                @db.Timestamptz(6)
  updated_at            DateTime?               @db.Timestamptz(6)
  is_active             Boolean?
  publisher_id          Int
  publisher_type        publishertype
  announcement_classes  announcement_classes[]  
  announcement_parents  announcement_parents[]
  announcement_teachers announcement_teachers[]

  @@index([id], map: "ix_announcements_id")
}

model assignment_document {
  assignment_id Int
  document_id   Int
  assignments   assignments @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents     documents   @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([assignment_id, document_id])
}

model documents {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar
  url                 String?               @db.VarChar
  uploaded_at         DateTime              @db.Timestamp(6)
  content             Bytes?
  submission_id       Int?
  assignment_document assignment_document[]
  student_submissions student_submissions?  @relation(fields: [submission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_documents_id")
}

model notes {
  id                 Int             @id @default(autoincrement())
  student_content_id Int
  note               String
  created_at         DateTime?       @db.Timestamp(6)
  updated_at         DateTime?       @db.Timestamp(6)
  student_content    student_content @relation(fields: [student_content_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_notes_id")
}

model student_content {
  id           Int       @id @default(autoincrement())
  student_id   Int
  content_id   String    @db.Uuid
  created_at   DateTime? @db.Timestamp(6)
  updated_at   DateTime? @db.Timestamp(6)
  is_completed Boolean?
  completed_at DateTime? @db.Timestamp(6)
  notes        notes[]
  contents     contents  @relation(fields: [content_id], references: [content_id], onDelete: NoAction, onUpdate: NoAction)
  students     students  @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_content_id")
}

model publish_lesson {
  lesson_id  Int
  publish_id Int
  lessons    lessons   @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishes  publishes @relation(fields: [publish_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([lesson_id, publish_id])
}

model publishes {
  id              Int              @id @default(autoincrement())
  publisher       String           @db.VarChar
  curriculum_year String           @db.VarChar
  subject_id      Int
  grade           Int
  contents        contents[]
  publish_lesson  publish_lesson[]
  subjects        subjects         @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tests           tests[]

  @@index([id], map: "ix_publishes_id")
}

model student_submissions {
  id            Int              @id @default(autoincrement())
  student_id    Int
  assignment_id Int
  submitted_at  DateTime?        @default(now()) @db.Timestamp(6)
  feedback      String?          @db.VarChar
  score         Int?
  is_graded     Boolean          @default(false)
  status        submissionstatus
  documents     documents[]
  assignments   assignments      @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students      students         @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_submissions_id")
}

model student_tests {
  id               Int                @id @default(autoincrement())
  student_id       Int
  test_id          Int
  submit_count     Int?               @default(0)
  students         students           @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tests            tests              @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  test_submissions test_submissions[]

  @@index([id], map: "ix_student_tests_id")
}

model assignment_test {
  id            Int          @id @default(autoincrement())
  assignment_id Int?
  test_id       Int?
  created_at    DateTime?    @db.Timestamp(6)
  assignments   assignments? @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tests         tests?       @relation(fields: [test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model student_test_answers {
  id               Int              @id @default(autoincrement())
  question_id      Int
  given_answer     Json?
  is_correct       Boolean?
  submission_id    Int
  questions        questions        @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  test_submissions test_submissions @relation(fields: [submission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_test_answers_id")
}

model test_submissions {
  id                   Int                    @id @default(autoincrement())
  student_test_id      Int
  submitted_at         DateTime               @default(now()) @db.Timestamp(6)
  score                Int?
  feedback             String?
  is_graded            Boolean?
  status               teststatus?
  student_test_answers student_test_answers[]
  student_tests        student_tests          @relation(fields: [student_test_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_test_submissions_id")
}

model badges {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar
  description    String
  image_url      String?          @db.VarChar
  badge_type     badgetype
  badge_level    badgelevel
  created_at     DateTime         @db.Timestamptz(6)
  updated_at     DateTime?        @db.Timestamptz(6)
  criteria_type  String           @db.VarChar
  criteria_value Int
  game_id        Int?
  games          games?           @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_badges student_badges[]

  @@index([id], map: "ix_badges_id")
}

model game_contents {
  id                      Int                       @id @default(autoincrement())
  content_data            Json
  solution_data           Json
  created_at              DateTime                  @db.Timestamptz(6)
  updated_at              DateTime?                 @db.Timestamptz(6)
  difficulty_level        Int?
  points                  Int
  game_id                 Int
  games                   games                     @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_game_progresses student_game_progresses[]

  @@index([id], map: "ix_game_contents_id")
}

model games {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar
  description   String
  created_at    DateTime        @db.Timestamptz(6)
  updated_at    DateTime?       @db.Timestamptz(6)
  grade         Int
  game_type     gametype
  subject_id    Int
  badges        badges[]
  game_contents game_contents[]
  subjects      subjects        @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_games_id")
}

model homework_ideas {
  id          Int       @id @default(autoincrement())
  unit_id     Int
  title       String    @db.VarChar
  content     String
  created_at  DateTime? @db.Timestamp(6)
  likes_count Int?
  usage_count Int?
  units       units     @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_homework_ideas_id")
}

model materiels {
  id                   Int          @id @default(autoincrement())
  name                 String?      @db.VarChar
  created_at           DateTime?    @db.Timestamp(6)
  updated_at           DateTime?    @db.Timestamp(6)
  is_active            Boolean?
  materiel_type        materieltype
  image_paths          Json?
  subject              subjecttype
  grade_list           Json?
  reading_time_minutes Int?
  materiel_content     Json?
  title                String?      @db.VarChar
  tags                 Json?

  @@index([id], map: "ix_materiels_id")
  @@index([name], map: "ix_materiels_name")
}

model student_analytics_summary {
  id                       Int       @id @default(autoincrement())
  student_id               Int?
  week_start_date          DateTime? @db.Timestamp(6)
  week_end_date            DateTime? @db.Timestamp(6)
  total_assignments        Int?
  total_tests              Int?
  average_assignment_score Float?
  average_test_score       Float?
  total_assignment_score   Float?
  total_test_score         Float?
  report_details           Json?     @db.Json
  created_at               DateTime? @db.Timestamp(6)
  total_solved_questions   Int?
  total_weekly_tasks       Int?
  weekly_task_score        Float?
  average_task_score       Float?
  ai_analysis              String?
  students                 students? @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model student_badges {
  id          Int      @id @default(autoincrement())
  acquired_at DateTime @db.Timestamptz(6)
  student_id  Int
  badge_id    Int
  badges      badges   @relation(fields: [badge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students    students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_badges_id")
}

model student_game_progresses {
  id              Int           @id @default(autoincrement())
  is_completed    Boolean?
  student_answer  Json?
  student_score   Int?
  student_id      Int
  game_content_id Int
  game_contents   game_contents @relation(fields: [game_content_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students        students      @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_game_progresses_id")
}

model student_schedules {
  id            Int             @id @default(autoincrement())
  created_at    DateTime?       @db.Timestamptz(6)
  updated_at    DateTime?       @db.Timestamptz(6)
  assignee_id   Int?
  assignee_type assigneetype
  student_id    Int
  is_active     Boolean?
  students      students        @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_tasks student_tasks[]

  @@index([id], map: "ix_student_schedules_id")
}

model student_tasks {
  id                Int               @id @default(autoincrement())
  description       String            @db.VarChar
  start_time        DateTime          @db.Time(6)
  end_time          DateTime          @db.Time(6)
  is_completed      Boolean?
  schedule_id       Int
  day_of_week       dayofweek
  last_completed_at DateTime?         @db.Timestamp(6)
  student_schedules student_schedules @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_student_tasks_id")
}

model content_embeddings {
  id              Int                    @id @default(autoincrement())
  content_id      String                 @db.Uuid
  chunk_text      String
  chunk_embedding Unsupported("vector")?
  chunk_number    Int
  unit_id         Int?
  level           Int?                   @db.SmallInt
  subject_id      Int?
  grade           Int?
  parent_id       String?                @db.Uuid
  publish_id      Int?
  created_at      DateTime?              @default(now()) @db.Timestamptz(6)
  contents        contents               @relation(fields: [content_id], references: [content_id], onDelete: NoAction, onUpdate: NoAction)
}

